# Copia este archivo a ".env" (sin .example) y rellena los valores reales.
# El .env NUNCA se sube a git (ver .gitignore).

# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-real

# True solo en desarrollo local. En producción SIEMPRE False.
DJANGO_DEBUG=True

# Dominios permitidos, separados por coma. En producción: tu dominio real.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Forzar HTTPS en producción (déjalo en True salvo que tu proxy ya lo haga)
DJANGO_SECURE_SSL_REDIRECT=True

# Dominios completos (con https://) desde los que se aceptan envios de
# formularios, separados por coma. Ej: https://gytglobalservice.com,https://www.gytglobalservice.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Resend (envío de formularios) -----------------------------------------
# API key de tu cuenta de Resend (resend.com/api-keys).
RESEND_API_KEY=re_tu_api_key_aqui

# Remitente verificado en Resend. Mientras no verifiques tu propio dominio
# ahí, usa "onboarding@resend.dev" (funciona, pero solo para pruebas).
RESEND_FROM_EMAIL=onboarding@resend.dev

# A qué correo llegan los leads de los formularios
CONTACTO_EMAIL_DESTINO=gtglobalservice2014@gmail.com
